# ---------------------------------------------------------------------------
# WHERE THE API KEY GOES
# ---------------------------------------------------------------------------
# The pipeline itself needs NO API key. Detection, recognition, page
# classification and the CRNN digit model all run locally on ONNX Runtime.
# You can process an entire archive with nothing configured here.
#
# The one optional feature that needs a key is the AI assist pass in the
# review UI (app/gemini_assist.py), which acts as a second opinion on pages
# the deterministic pipeline could not resolve. It only ever auto-files when
# it AGREES with the deterministic pipeline; otherwise it pre-fills a
# suggestion for a human to confirm.
#
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Set to 1 to run OCR on the GPU (see pipeline/gpu_env.py). Unset = CPU.
# ECR_USE_GPU=1
